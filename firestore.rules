rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is the teacher who owns the assignment
    function isAssignmentOwner(teacherId) {
      return request.auth != null && request.auth.uid == teacherId;
    }

    // Users: Only the user themselves can read/write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Assignments: 
    // - Anyone can read a published assignment (for students)
    // - Only owners can create/update/delete
    match /assignments/{assignmentId} {
      allow read: if resource.data.status == 'published' || isAssignmentOwner(resource.data.teacherId);
      allow create: if request.auth != null;
      allow update, delete: if isAssignmentOwner(resource.data.teacherId);
    }

    // Submissions:
    // - Students can create submissions
    // - Only teachers can read submissions for their assignments
    // - Students can read their own submission immediately after nộp bài (based on ID)
    match /submissions/{submissionId} {
      allow create: if true; // Public access for students
      allow read: if true; // Allow reading by ID for the result page
      allow update, delete: if false; // Submissions are final
    }
  }
}
